# Copy this file to a new file named .env and fill in your own values.
# .env is ignored by git, so your passwords never get uploaded to GitHub.

# A long random string Flask uses to protect logins and forms.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Where the database is.
# Leave this line out (or blank) to use a local SQLite file: instance/liftlog.db
# To use MySQL instead, uncomment and fill in your MySQL username, password and database name:
# DATABASE_URL=mysql+pymysql://liftlog_user:your_password@localhost:3306/liftlog

# Turns on auto-reload and detailed error pages while developing. Never use on a real server.
FLASK_DEBUG=1
